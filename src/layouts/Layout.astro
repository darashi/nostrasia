---
import '../styles/tailwind.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Nostrasia Timeline', description = 'Nostrasia' } =
	Astro.props as Props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="h-full" data-theme="nostrasia2026">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin="anonymous"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;700&family=Unbounded:wght@600;900&family=Zen+Kaku+Gothic+New:wght@400;700;900&display=swap"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-grid flex min-h-screen flex-col font-sans text-ink antialiased">
		<header
			class="sticky top-0 z-10 flex h-[60px] shrink-0 items-center gap-3 border-b-[3px] border-ink bg-base-100 pl-4 pr-3"
		>
			<a
				href="https://nostrasia.com"
				target="_blank"
				rel="noopener noreferrer"
				class="mr-auto flex items-center gap-2 font-en text-[13px] font-semibold tracking-[0.04em] no-underline"
			>
				<svg viewBox="0 0 30 30" aria-hidden="true" class="h-[30px] w-[30px]">
					<circle cx="9" cy="9" r="8" fill="#8E30EB"></circle>
					<path d="M22 2l7 13H15z" fill="#F2542D"></path>
					<rect x="2" y="18" width="10" height="10" fill="#F6C324"></rect>
					<path d="M16 28a7 7 0 0 1 14 0z" fill="#0E7C7B"></path>
				</svg>
				NOSTRASIA
			</a>
		</header>
		<slot />
	</body>
</html>
